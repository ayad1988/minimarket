{
  "realm": "minimarket",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "none",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "admin", "description": "Administrateur de la boutique" }
    ]
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@minimarket.local",
      "firstName": "Admin",
      "lastName": "MiniMarket",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "realmRoles": ["admin"]
    }
  ],
  "clients": [
    {
      "clientId": "minimarket-front",
      "name": "MiniMarket front",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "minimarket-dev-cli",
      "name": "DEV ONLY - tests curl (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    }
  ]
}
